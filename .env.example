# ==============================================================================
# PLEY.UZ — Environment Variables & Secrets Reference
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development

# Database Layer (Neon / PostgreSQL with Kysely)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Admin Access (comma-separated list of Google emails granted the ADMIN role)
ADMIN_EMAILS=sardor@pley.uz,admin@pley.uz

# Google OAuth 2.0 (Backend & Web/Mobile authentication)
GOOGLE_CLIENT_ID=210623201179-4i14mlaibn8lh0h6clu6mthh3g8084lm.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXT_PUBLIC_GOOGLE_CLIENT_ID=210623201179-4i14mlaibn8lh0h6clu6mthh3g8084lm.apps.googleusercontent.com

# Cloudflare Turnstile Bot Protection
CLOUDFLARE_SITE_KEY=0x4AAAAAAFpYVK4Lc7_KcYai
CLOUDFLARE_SECRET_KEY=YOUR_CLOUDFLARE_SECRET_KEY
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=0x4AAAAAAFpYVK4Lc7_KcYai

# UploadThing (Avatar & Venue image upload CDN)
UPLOADTHING_SECRET=YOUR_UPLOADTHING_SECRET_OR_TOKEN

# Payment Providers (Optional in Development)
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_SECRET_KEY

# Frontend Endpoints
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
