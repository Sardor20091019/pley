{
  "name": "pleyuz-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run start",
    "dev:api": "ts-node apps/api/src/main.ts",
    "dev:web": "npm --prefix apps/web run start",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "npm --prefix apps/web run build",
    "build": "tsc -p apps/api/tsconfig.json && npm --prefix apps/web run build && node scripts/sync-build-output.js",
    "lint:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "lint:web": "tsc -p apps/web/tsconfig.app.json --noEmit",
    "lint": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.app.json --noEmit"
  }
}
