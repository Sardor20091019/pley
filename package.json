{
  "name": "pleyuz-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev apps/web --webpack",
    "dev:api": "ts-node apps/api/src/main.ts",
    "dev:web": "next dev apps/web --webpack",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "next build apps/web --webpack",
    "build": "tsc -p apps/api/tsconfig.json && next build apps/web --webpack",
    "test": "vitest run --root apps/api",
    "lint:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "lint:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0"
  }
}
